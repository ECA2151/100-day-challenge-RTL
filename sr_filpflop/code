module SR(
    input s,
    input r,
    input clk,
    input rst,
    output reg q
);
    parameter
        HOLD = 2'b00,
        RESET = 2'b01,
        SET = 2'b10,
        INV = 2'b11;

    always @(posedge clk or posedge rst) begin
        if (rst) 
            q <= 1'b0;  // Non-blocking assignment
        else begin
            case ({s, r})
                HOLD: q <= q;      // Hold current state
                RESET: q <= 1'b0;  // Reset state
                SET: q <= 1'b1;    // Set state
                INV: q <= 1'bx;    // Invalid state
            endcase
        end
    end

endmodule
